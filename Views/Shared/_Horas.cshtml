@model Painel
<div class="painel tabela-painel"><div class="painel-titulo"><h2>Horas registradas</h2><span class="text-muted">@Model.Linhas.Count períodos</span></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Data</th><th>Demanda</th><th>Início</th><th>Fim</th><th>Tempo</th><th>Valor estimado</th></tr></thead><tbody>
@foreach(var linha in Model.Linhas) {
<tr><td>@linha.Data.ToString("dd/MM/yyyy")</td><td><a asp-controller="Demandas" asp-action="Detalhes" asp-route-id="@linha.DemandaId">@linha.Titulo</a><small class="d-block text-muted">DEV-@linha.DemandaId.ToString("000") @linha.Descricao</small></td><td>@linha.Inicio.ToString("HH:mm:ss")</td><td>@linha.Fim.ToString("HH:mm:ss") @if(linha.EmAndamento){<span class="badge-status">Em curso</span>}</td><td class="fw-bold">@Formato.Horas(linha.Segundos)</td><td>@Formato.Dinheiro(linha.Valor(Model.ValorHora))</td></tr>
}
@if(Model.Linhas.Count == 0) { <tr><td colspan="6" class="vazio"><i class="fa-regular fa-clock"></i><strong>Nenhuma hora neste período</strong><span>Inicie uma demanda ou registre um apontamento manual.</span></td></tr> }
</tbody><tfoot><tr><td colspan="4">Total do período</td><td>@Formato.Horas(Model.Segundos)</td><td>@Formato.Dinheiro(Model.Estimado)</td></tr></tfoot></table></div></div>
