@model LancamentoManual
@{ ViewData["Title"] = "Lançamento manual"; }
<div class="titulo-pagina"><div><span class="sobretitulo">TRABALHO / APONTAMENTOS</span><h1>Registrar horas trabalhadas</h1><p>Para aquele período em que você esqueceu de iniciar o cronômetro.</p></div></div>
<form asp-action="Salvar" method="post" class="painel formulario"><div class="row g-4"><div class="col-12"><label asp-for="DemandaId">Demanda *</label><select asp-for="DemandaId" class="form-select" required><option value="">Selecione uma demanda</option>@foreach(Demanda demanda in ViewBag.Demandas){<option value="@demanda.Id">@demanda.Codigo · @demanda.Titulo</option>}</select></div><div class="col-md-4"><label asp-for="Data">Data de início *</label><input asp-for="Data" type="date" class="form-control" required/></div><div class="col-md-4"><label asp-for="Inicio">Hora inicial *</label><input asp-for="Inicio" type="time" class="form-control" required/></div><div class="col-md-4"><label asp-for="Fim">Hora final *</label><input asp-for="Fim" type="time" class="form-control" required/></div><div class="col-12"><div class="nota">Se a hora final for anterior à inicial, o término será considerado no dia seguinte. Exemplo: 23:00 → 01:30 = 2h30. Horário de Brasília.</div></div><div class="col-12"><label asp-for="Descricao">Descrição do trabalho</label><textarea asp-for="Descricao" class="form-control" rows="4" maxlength="2000"></textarea></div></div><div class="formulario-rodape"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary">Registrar horas</button></div></form>
