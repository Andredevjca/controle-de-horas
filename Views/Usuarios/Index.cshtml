@model List<Usuario>
@{ ViewData["Title"] = "Usuários"; }
<div class="titulo-pagina"><div><span class="sobretitulo">CADASTROS</span><h1>Usuários</h1><p>Gerencie os acessos ao sistema.</p></div><a class="btn btn-primary" asp-action="Editar"><i class="fa-solid fa-plus me-2"></i>Novo usuário</a></div><div class="painel tabela-painel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Nome</th><th>Usuário</th><th>E-mail</th><th>Status</th><th>Ações</th></tr></thead><tbody>@foreach(var usuario in Model){<tr><td>@usuario.Nome @if(usuario.Administrador){<small class="d-block text-muted">Administrador</small>}</td><td>@usuario.Login</td><td>@(usuario.Email ?? "—")</td><td><span class="badge-status @(usuario.Ativo ? "andamento" : "")">@(usuario.Ativo ? "Ativo" : "Inativo")</span></td><td><a class="btn btn-outline-secondary" asp-action="Editar" asp-route-id="@usuario.Id">Editar</a></td></tr>}</tbody></table></div></div>
