@model EdicaoUsuario
@{ ViewData["Title"] = Model.Id == 0 ? "Novo usuário" : "Editar usuário"; }
<div class="titulo-pagina"><div><span class="sobretitulo">CADASTROS / USUÁRIOS</span><h1>@ViewData["Title"]</h1><p>Cada usuário possui seu próprio espaço de trabalho.</p></div></div><form asp-action="Salvar" method="post" class="painel formulario"><input asp-for="Id" type="hidden"/><div class="row g-4"><div class="col-md-6"><label asp-for="Nome">Nome *</label><input asp-for="Nome" class="form-control" required maxlength="120"/></div><div class="col-md-6"><label asp-for="Login">Usuário *</label><input asp-for="Login" class="form-control" required maxlength="60" autocomplete="off"/></div><div class="col-12"><label asp-for="Email">E-mail</label><input asp-for="Email" type="email" class="form-control" maxlength="180"/></div><div class="col-md-6"><label asp-for="NovaSenha">@(Model.Id == 0 ? "Senha *" : "Nova senha (opcional)")</label><input asp-for="NovaSenha" type="password" class="form-control" minlength="8" required="@(Model.Id == 0)" autocomplete="new-password"/><small class="text-muted">Mínimo de 8 caracteres.</small></div><div class="col-md-6"><label asp-for="ConfirmarSenha">Confirmar senha</label><input asp-for="ConfirmarSenha" type="password" class="form-control" minlength="8" required="@(Model.Id == 0)" autocomplete="new-password"/></div><div class="col-12"><div class="form-check"><input asp-for="Ativo" class="form-check-input"/><label asp-for="Ativo" class="form-check-label">Usuário ativo</label></div><small class="text-muted">Inative o acesso para preservar os registros existentes.</small></div></div><div class="formulario-rodape"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary">Salvar usuário</button></div></form>
