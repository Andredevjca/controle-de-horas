@model Painel
@{ Layout = null; }
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Relatório de horas · @Model.Filtro.Inicio.ToString("MM-yyyy")</title><link href="~/bibliotecas/bootstrap.min.css" rel="stylesheet"/><link href="~/css/horas.css" rel="stylesheet"/></head><body class="relatorio-impressao"><div class="nao-imprimir barra-impressao"><button type="button" class="btn btn-primary" id="imprimirRelatorio">Salvar em PDF / Imprimir</button><span>Na janela de impressão, escolha “Salvar como PDF”.</span></div><main class="folha-relatorio"><header class="cabecalho-relatorio"><div><span class="sobretitulo">RELATÓRIO PROFISSIONAL</span><h1>Controle de horas</h1><p>@User.Identity?.Name</p></div><div><strong>@Model.Filtro.Inicio.ToString("MMMM/yyyy").ToUpper()</strong><p>@Model.Filtro.Inicio.ToString("dd/MM/yyyy") a @Model.Filtro.Fim.ToString("dd/MM/yyyy")</p></div></header><div class="indicadores"><div class="indicador"><span>Horas trabalhadas</span><strong>@Formato.Horas(Model.Segundos)</strong></div><div class="indicador"><span>Valor/hora</span><strong class="nao-definido">@(Model.ValorHora.HasValue ? Formato.Dinheiro(Model.ValorHora) : "Não definido")</strong></div><div class="indicador"><span>Total estimado</span><strong>@Formato.Dinheiro(Model.Estimado)</strong></div></div><partial name="_Horas" model="Model"/><h2 class="mt-4">Pagamentos da competência</h2><table class="table"><thead><tr><th>Data</th><th>Competência</th><th>Observação</th><th>Valor pago</th></tr></thead><tbody>@foreach(var pagamento in Model.Pagamentos){<tr><td>@pagamento.DataPagamento.ToString("dd/MM/yyyy")</td><td>@pagamento.PeriodoInicio.ToString("dd/MM/yyyy") a @pagamento.PeriodoFim.ToString("dd/MM/yyyy")</td><td>@pagamento.Observacao</td><td>@Formato.Dinheiro(pagamento.ValorPago)</td></tr>}@if(Model.Pagamentos.Count==0){<tr><td colspan="4">Nenhum pagamento para a competência selecionada.</td></tr>}</tbody></table><div class="totais-relatorio"><span>Pago: <strong>@Formato.Dinheiro(Model.Pago)</strong></span><span>Saldo a receber: <strong>@Formato.Dinheiro(Model.Saldo)</strong></span></div><footer class="mt-4 text-muted small">Emitido em @ControleServico.AgoraLocal.ToString("dd/MM/yyyy HH:mm") · Horário de Brasília.<br/>Pagamentos incluídos quando toda a competência está contida no período. Cronômetros em curso são contabilizados até a emissão.</footer></main><script src="~/js/impressao.js"></script></body></html>
