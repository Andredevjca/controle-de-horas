@model Painel
@{ ViewData["Title"] = ViewContext.RouteData.Values["action"]?.ToString() == "Valores" ? "Valores" : "Relatórios"; }
<div class="titulo-pagina"><div><span class="sobretitulo">VISÃO DO PERÍODO</span><h1>@ViewData["Title"]</h1><p>Seu trabalho traduzido em horas e resultados.</p></div><div class="d-flex gap-2"><a data-no-spa asp-action="Excel" asp-route-Inicio="@Model.Filtro.Inicio.ToString("yyyy-MM-dd")" asp-route-Fim="@Model.Filtro.Fim.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary"><i class="fa-solid fa-file-excel me-2"></i>Excel</a><a asp-action="Imprimir" asp-route-Inicio="@Model.Filtro.Inicio.ToString("yyyy-MM-dd")" asp-route-Fim="@Model.Filtro.Fim.ToString("yyyy-MM-dd")" class="btn btn-primary" target="_blank" rel="noopener"><i class="fa-solid fa-file-pdf me-2"></i>PDF / Imprimir</a></div></div>
<partial name="_Filtros" model="Model"/>
<div class="indicadores"><div class="indicador"><span>Horas trabalhadas</span><strong>@Formato.Horas(Model.Segundos)</strong><small>Período selecionado</small></div><div class="indicador"><span>Valor/hora</span><strong class="nao-definido">@(Model.ValorHora.HasValue ? Formato.Dinheiro(Model.ValorHora) : "Não definido")</strong><small>Aplicado a todo o histórico</small></div><div class="indicador"><span>Total estimado</span><strong>@Formato.Dinheiro(Model.Estimado)</strong><small>Calculado sobre o tempo exato</small></div><div class="indicador"><span>Saldo a receber</span><strong>@Formato.Dinheiro(Model.Saldo)</strong><small>Pagamentos: @Formato.Dinheiro(Model.Pago)</small></div></div>
@if(!Model.ValorHora.HasValue){<div class="nota mb-4"><i class="fa-solid fa-circle-info me-2"></i>Suas horas estão registradas. <a asp-controller="Configuracoes" asp-action="Index">Defina o valor/hora</a> quando quiser para calcular os valores automaticamente.</div>}
<partial name="_Horas" model="Model"/>
<p class="text-muted mt-3">Os pagamentos considerados possuem a competência inteira dentro do período selecionado. Para conferir o saldo completo, consulte o dashboard. Valores negativos indicam crédito recebido.</p>
