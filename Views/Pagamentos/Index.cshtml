@model Painel
@{ ViewData["Title"] = "Pagamentos"; }
<div class="titulo-pagina"><div><span class="sobretitulo">FINANCEIRO</span><h1>Pagamentos</h1><p>Acompanhe o que já recebeu e o que ainda está pendente.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#novoPagamento"><i class="fa-solid fa-plus me-2"></i>Registrar pagamento</button></div>
<partial name="_Filtros" model="Model"/>
<div class="indicadores"><div class="indicador"><span>Horas do período</span><strong>@Formato.Horas(Model.Segundos)</strong></div><div class="indicador"><span>Valor estimado</span><strong>@Formato.Dinheiro(Model.Estimado)</strong></div><div class="indicador"><span>Valor pago</span><strong>@Formato.Dinheiro(Model.Pago)</strong></div><div class="indicador"><span>A receber</span><strong>@Formato.Dinheiro(Model.Saldo)</strong><small>@(Model.Saldo == null ? "Valor/hora não definido" : Model.Saldo <= 0 ? "Pago" : "Aguardando pagamento")</small></div></div>
<div class="painel tabela-painel"><div class="painel-titulo"><h2>Recebimentos registrados</h2><span class="badge-status">@Model.Pagamentos.Count pagamentos</span></div><div class="table-responsive"><table class="table"><thead><tr><th>Data do pagamento</th><th>Competência</th><th>Observação</th><th>Valor pago</th><th>Status</th></tr></thead><tbody>@foreach(var pagamento in Model.Pagamentos){<tr><td>@pagamento.DataPagamento.ToString("dd/MM/yyyy")</td><td>@pagamento.PeriodoInicio.ToString("dd/MM/yyyy") a @pagamento.PeriodoFim.ToString("dd/MM/yyyy")</td><td>@pagamento.Observacao</td><td class="fw-bold">@Formato.Dinheiro(pagamento.ValorPago)</td><td><span class="badge-status andamento">Pago</span></td></tr>}@if(Model.Pagamentos.Count==0){<tr><td class="vazio" colspan="5"><strong>Nenhum pagamento neste período</strong><span>Registre o recebimento assim que o pagamento for realizado.</span></td></tr>}</tbody></table></div></div>
<p class="text-muted mt-3">O filtro inclui pagamentos cuja competência inteira está dentro do período. Recebimentos parciais são somados; saldo negativo representa crédito. Pagamentos não dependem de valor/hora definido.</p>
<div class="modal fade" id="novoPagamento" tabindex="-1" aria-labelledby="tituloPagamento"><div class="modal-dialog"><form asp-action="Salvar" method="post" class="modal-content"><div class="modal-header"><h2 id="tituloPagamento">Registrar pagamento</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><div class="row g-3"><div class="col-6"><label for="PeriodoInicio">Competência inicial *</label><input class="form-control" type="date" id="PeriodoInicio" name="PeriodoInicio" value="@Model.Filtro.Inicio.ToString("yyyy-MM-dd")" required/></div><div class="col-6"><label for="PeriodoFim">Competência final *</label><input class="form-control" type="date" id="PeriodoFim" name="PeriodoFim" value="@Model.Filtro.Fim.ToString("yyyy-MM-dd")" required/></div><div class="col-6"><label for="DataPagamento">Data do pagamento *</label><input class="form-control" type="date" id="DataPagamento" name="DataPagamento" value="@ControleServico.AgoraLocal.ToString("yyyy-MM-dd")" required/></div><div class="col-6"><label for="ValorPago">Valor recebido (R$) *</label><input class="form-control" id="ValorPago" name="ValorPago" inputmode="decimal" placeholder="0,00" pattern="[0-9]+([,][0-9]{1,2})?" required/></div><div class="col-12"><label for="Observacao">Observação</label><textarea class="form-control" id="Observacao" name="Observacao" maxlength="2000" rows="3"></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary">Registrar recebimento</button></div></form></div></div>
