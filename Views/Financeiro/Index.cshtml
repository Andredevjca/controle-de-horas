@model FinanceiroPainel
@{ ViewData["Title"] = "Financeiro"; var maiorRecebimento = Model.Meses.Select(m => m.Recebido).DefaultIfEmpty().Max(); }
<div class="titulo-pagina"><div><span class="sobretitulo">VISÃO FINANCEIRA</span><h1>Financeiro</h1><p>Recebimentos, demandas e horas por mês.</p></div><a asp-controller="Pagamentos" asp-action="Index" class="btn btn-primary">Registrar pagamentos</a></div>
<partial name="_Filtros" model="@(new Painel { Filtro = Model.Filtro })"/>
<div class="indicadores">
<div class="indicador"><span>Recebido no período</span><strong>@Formato.Dinheiro(Model.Recebido)</strong><small>Pela data da baixa · @Model.DemandasRecebidas demandas</small></div>
<div class="indicador"><span>Demandas trabalhadas</span><strong>@Model.Demandas</strong><small>Com horas no período</small></div>
<div class="indicador"><span>Horas trabalhadas</span><strong>@Formato.Horas(Model.Segundos)</strong><small>Pela data do trabalho</small></div>
<div class="indicador"><span>A receber pelas horas</span><strong>@Formato.Dinheiro(Model.Saldo)</strong><small>Saldo das horas filtradas</small></div>
</div>
<div class="painel tabela-painel mb-4"><div class="painel-titulo"><h2>Evolução por mês</h2><span class="text-muted">Total recebido em todo o histórico: @Formato.Dinheiro(Model.TotalRecebidoGeral)</span></div>
<div class="table-responsive"><table class="table"><thead><tr><th>Mês da baixa</th><th>Demandas com baixa</th><th>Registros de baixa</th><th>Total recebido</th></tr></thead><tbody>
@foreach(var mes in Model.Meses) {
    var percentual = maiorRecebimento > 0 ? Math.Clamp(mes.Recebido / maiorRecebimento * 100, 0, 100) : 0;
    var largura = percentual.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
<tr><td>@mes.Mes.ToString("MM/yyyy")</td><td>@mes.DemandasRecebidas</td><td>@mes.QuantidadeBaixas</td><td style="min-width: 180px"><strong>@Formato.Dinheiro(mes.Recebido)</strong><div class="progress mt-2" style="height: 6px; max-width: 240px; border-radius: 4px" role="progressbar" aria-label="Recebimento de @mes.Mes.ToString("MM/yyyy") em relação ao maior mês do filtro" aria-valuenow="@largura" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width: @largura%; border-radius: 4px"></div></div></td></tr>
}
</tbody><tfoot><tr><td colspan="3">Total de baixas no período</td><td class="fw-bold">@Formato.Dinheiro(Model.Recebido)</td></tr></tfoot></table></div></div>
<p class="text-muted">Os valores são somados pela data da baixa. Uma baixa em lote entra integralmente no mês em que foi registrada, mesmo que as demandas sejam de meses anteriores.</p>
<div class="painel tabela-painel"><div class="painel-titulo"><h2>Recebimentos pela data da baixa</h2><span class="badge-status">@Model.Recebimentos.Count registros</span></div><div class="table-responsive"><table class="table"><thead><tr><th>Demanda</th><th>Data da baixa</th><th>Competência</th><th>Observação</th><th>Valor recebido</th><th>Status do registro</th></tr></thead><tbody>
@foreach(var pagamento in Model.Recebimentos) {
<tr><td>@(pagamento.DemandaNome ?? "Sem demanda (registro anterior)")</td><td>@pagamento.DataPagamento.ToString("dd/MM/yyyy")</td><td>@pagamento.PeriodoInicio.ToString("dd/MM/yyyy") a @pagamento.PeriodoFim.ToString("dd/MM/yyyy")</td><td>@pagamento.Observacao</td><td>@Formato.Dinheiro(pagamento.ValorPago)</td><td><span class="badge-status">Recebido</span></td></tr>
}
@if(Model.Recebimentos.Count == 0) { <tr><td colspan="6" class="vazio">Nenhum recebimento nas datas selecionadas.</td></tr> }
</tbody></table></div></div>
