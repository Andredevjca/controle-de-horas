@model Painel
@{ ViewData["Title"] = "Dashboard"; var hora = ControleServico.AgoraLocal.Hour; }
<div class="titulo-pagina"><div><div class="sobretitulo">SEU TEMPO, BEM INVESTIDO</div><h1>Olá, @User.Identity?.Name<span class="text-primary">.</span></h1><p>@(hora < 12 ? "Bom dia" : hora < 18 ? "Boa tarde" : "Boa noite"). Tudo pronto para o próximo passo?</p></div><a class="btn btn-primary" asp-controller="Demandas" asp-action="Editar"><i class="fa-solid fa-plus me-2"></i>Nova demanda</a></div>
<div class="indicadores">
<div class="indicador"><span>Hoje <i class="fa-regular fa-clock"></i></span><strong>@Formato.Horas(Model.SegundosHoje)</strong><small>Tempo efetivamente trabalhado</small></div>
<div class="indicador"><span>Este mês <i class="fa-regular fa-calendar"></i></span><strong>@Formato.Horas(Model.SegundosMes)</strong><small>@ControleServico.AgoraLocal.ToString("MMMM 'de' yyyy")</small></div>
<div class="indicador"><span>Valor/hora <i class="fa-solid fa-coins"></i></span><strong class="@(Model.ValorHora == null ? "nao-definido" : "")">@(Model.ValorHora.HasValue ? Formato.Dinheiro(Model.ValorHora) : "Não definido")</strong><a asp-controller="Configuracoes" asp-action="Index">Configurar valor <i class="fa-solid fa-arrow-right ms-1"></i></a></div>
<div class="indicador"><span>A receber <i class="fa-solid fa-wallet"></i></span><strong>@Formato.Dinheiro(Model.SaldoGeral)</strong><small>Saldo de todo o histórico</small></div>
</div>
<div class="row g-4 mb-4"><div class="col-lg-8"><section class="painel trabalho">
<div class="d-flex justify-content-between align-items-center"><span class="sobretitulo">TRABALHO ATUAL</span><span class="badge-status @(Model.Trabalho?.Status == "Em andamento" ? "andamento" : "")"><span class="ponto"></span> @(Model.Trabalho?.Status ?? "Tudo pronto")</span></div>
@if(Model.Trabalho is Demanda trabalho) {
<div class="trabalho-demanda"><small>@trabalho.Codigo · @(trabalho.ProjetoNome ?? "Sem projeto")</small><h2><a asp-controller="Demandas" asp-action="Detalhes" asp-route-id="@trabalho.Id">@trabalho.Titulo</a></h2></div>
<div class="cronometro" data-segundos="@trabalho.Segundos" data-ativo="@(trabalho.Status == "Em andamento" ? "true" : "false")">@TimeSpan.FromSeconds(trabalho.Segundos).ToString(@"hh\:mm\:ss")</div><p class="text-muted">Tempo trabalhado nesta demanda</p><partial name="_Acoes" model="trabalho"/>
} else {
<div class="trabalho-demanda"><small>UM PASSO DE CADA VEZ</small><h2>Qual é o foco de agora?</h2></div><div class="cronometro inativo">00:00:00</div><p class="text-muted">Escolha uma demanda e comece a registrar seu tempo.</p><a class="btn btn-primary" asp-controller="Demandas" asp-action="Index"><i class="fa-solid fa-play me-2"></i>Escolher demanda</a>
}
<div class="trabalho-nota"><i class="fa-solid fa-shield-halved me-2"></i>Seu tempo fica salvo, mesmo se você fechar esta página.</div>
</section></div><div class="col-lg-4"><section class="painel resumo"><span class="sobretitulo">SEU RITMO</span><h2>Espaço para se concentrar.</h2><p>Uma demanda por vez.<br/>Cada minuto registrado faz a diferença.</p><div class="resumo-linha"><span>Demandas em aberto</span><strong>@Model.Demandas.Count(d => d.Status is "Pendente" or "Pausada" or "Em andamento")</strong></div><div class="resumo-linha"><span>Demandas concluídas</span><strong>@Model.Demandas.Count(d => d.Status == "Concluída")</strong></div><a asp-controller="Apontamentos" asp-action="Manual" class="atalho"><i class="fa-solid fa-plus"></i><span>Esqueceu o cronômetro?<small>Registre suas horas manualmente.</small></span><i class="fa-solid fa-arrow-right"></i></a></section></div></div>
<div class="painel tabela-painel"><div class="painel-titulo"><h2>Suas demandas recentes</h2><a asp-controller="Demandas" asp-action="Index">Ver todas <i class="fa-solid fa-arrow-right ms-1"></i></a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Demanda</th><th>Projeto</th><th>Status</th><th>Tempo registrado</th><th></th></tr></thead><tbody>@foreach(var demanda in Model.Demandas.Take(5)) {<tr><td><small class="text-muted d-block">@demanda.Codigo</small><a asp-controller="Demandas" asp-action="Detalhes" asp-route-id="@demanda.Id">@demanda.Titulo</a></td><td>@(demanda.ProjetoNome ?? "—")</td><td><span class="badge-status">@demanda.Status</span></td><td>@Formato.Horas(demanda.Segundos)</td><td><a asp-controller="Demandas" asp-action="Detalhes" asp-route-id="@demanda.Id" aria-label="Abrir demanda"><i class="fa-solid fa-arrow-right"></i></a></td></tr>}
@if(Model.Demandas.Count == 0){<tr><td colspan="5" class="vazio"><strong>Sua próxima entrega começa aqui.</strong><span>Crie sua primeira demanda para organizar o trabalho.</span></td></tr>}
</tbody></table></div></div>
