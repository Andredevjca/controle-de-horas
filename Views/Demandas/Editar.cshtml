@model Demanda
@{ ViewData["Title"] = Model.Id == 0 ? "Nova demanda" : "Editar demanda"; }
<div class="titulo-pagina"><div><span class="sobretitulo">TRABALHO / DEMANDAS</span><h1>@ViewData["Title"]</h1><p>Defina a entrega. O tempo você registra no seu ritmo.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Voltar</a></div>
<form asp-action="Salvar" method="post" class="painel formulario"><input asp-for="Id" type="hidden"/><div class="row g-4"><div class="col-12"><label asp-for="Titulo">Título *</label><input asp-for="Titulo" class="form-control" required maxlength="180" placeholder="O que precisa ser feito?"/></div><div class="col-12"><label asp-for="Descricao">Descrição</label><textarea asp-for="Descricao" class="form-control" rows="4" maxlength="10000" placeholder="Contexto e detalhes da demanda"></textarea></div><div class="col-md-6"><label asp-for="ProjetoId">Projeto</label><div class="d-flex gap-2"><select asp-for="ProjetoId" class="form-select"><option value="">Sem projeto</option>@foreach(Projeto projeto in ViewBag.Projetos){<option value="@projeto.Id">@projeto.Nome</option>}</select><button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#novoProjeto" aria-label="Novo projeto"><i class="fa-solid fa-plus"></i></button></div></div><div class="col-md-6"><label asp-for="Prioridade">Prioridade</label><select asp-for="Prioridade" class="form-select"><option>Baixa</option><option>Normal</option><option>Alta</option><option>Urgente</option></select></div><div class="col-md-6"><label asp-for="DataRecebimento">Data de recebimento *</label><input asp-for="DataRecebimento" type="date" class="form-control" required/></div><div class="col-md-6"><label asp-for="Prazo">Prazo</label><input asp-for="Prazo" type="date" class="form-control"/></div><div class="col-12"><label asp-for="Observacoes">Observações</label><textarea asp-for="Observacoes" class="form-control" rows="3" maxlength="10000"></textarea></div></div><div class="formulario-rodape"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary">Salvar demanda</button></div></form>
<div class="modal fade" id="novoProjeto" tabindex="-1" aria-labelledby="tituloProjeto"><div class="modal-dialog"><form class="modal-content" asp-action="Projeto" method="post"><div class="modal-header"><h2 id="tituloProjeto">Novo projeto</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><label for="nome">Nome do projeto</label><input class="form-control" id="nome" name="nome" required maxlength="120"/><small class="text-muted">Salve o projeto antes de preencher a demanda.</small></div><div class="modal-footer"><button class="btn btn-primary">Criar projeto</button></div></form></div></div>
