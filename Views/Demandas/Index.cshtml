@model Painel
@{ ViewData["Title"] = "Demandas"; }
<div class="titulo-pagina"><div><span class="sobretitulo">TRABALHO</span><h1>Demandas</h1><p>Organize suas entregas e acompanhe cada etapa.</p></div><a class="btn btn-primary" asp-action="Editar"><i class="fa-solid fa-plus me-2"></i>Nova demanda</a></div>
<form class="painel filtros mb-4" method="get"><div class="flex-grow-1"><label for="busca">Buscar demanda</label><input class="form-control" id="busca" name="busca" value="@ViewBag.Busca" placeholder="Título ou código da demanda"/></div><div><label for="status">Status</label><select class="form-select" name="status" id="status"><option value="">Todos os status</option>@foreach(var status in new[]{"Pendente","Em andamento","Pausada","Concluída","Cancelada"}){<option selected="@(ViewBag.Status == status)">@status</option>}</select></div><button class="btn btn-primary">Buscar</button></form>
<div class="painel tabela-painel"><div class="painel-titulo"><h2>Todas as demandas</h2><span class="text-muted">@Model.Demandas.Count registros</span></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Demanda</th><th>Projeto</th><th>Prioridade</th><th>Status</th><th>Prazo</th><th>Total de horas</th><th>Ações</th></tr></thead><tbody>@foreach(var demanda in Model.Demandas){<tr><td><small class="text-muted d-block">@demanda.Codigo</small><a asp-action="Detalhes" asp-route-id="@demanda.Id">@demanda.Titulo</a></td><td>@(demanda.ProjetoNome ?? "—")</td><td>@demanda.Prioridade</td><td><span class="badge-status @(demanda.Status == "Em andamento" ? "andamento" : "")">@demanda.Status</span></td><td>@(demanda.Prazo?.ToString("dd/MM/yyyy") ?? "—")</td><td>@Formato.Horas(demanda.Segundos)</td><td><a asp-action="Detalhes" asp-route-id="@demanda.Id" class="btn btn-outline-secondary">Ver horas por dia</a> <a asp-action="Editar" asp-route-id="@demanda.Id" class="btn btn-link">Editar</a></td></tr>}
@if(Model.Demandas.Count == 0){<tr><td colspan="7" class="vazio"><i class="fa-solid fa-list-check"></i><strong>Nenhuma demanda encontrada</strong><span>Crie uma demanda ou ajuste os filtros.</span></td></tr>}
</tbody></table></div></div>
