@model DetalhesDemanda
@{ ViewData["Title"] = Model.Demanda.Codigo; }
<div class="titulo-pagina"><div><span class="sobretitulo">@Model.Demanda.Codigo · @(Model.Demanda.ProjetoNome ?? "Sem projeto")</span><h1>@Model.Demanda.Titulo</h1><p><span class="badge-status">@Model.Demanda.Status</span> · Prioridade @Model.Demanda.Prioridade</p></div><a asp-action="Editar" asp-route-id="@Model.Demanda.Id" class="btn btn-outline-secondary">Editar demanda</a></div>
<div class="row g-4"><div class="col-lg-7"><section class="painel trabalho"><span class="sobretitulo">TOTAL DE HORAS DA DEMANDA</span><div class="cronometro" data-segundos="@Model.Demanda.Segundos" data-ativo="@(Model.Demanda.Status == "Em andamento" ? "true" : "false")">@Formato.Horas(Model.Demanda.Segundos)</div><partial name="_Acoes" model="Model.Demanda"/>
<form class="mt-3" asp-action="Acao" method="post" data-confirmar="Confirmar a alteração de status desta demanda?"><input type="hidden" name="id" value="@Model.Demanda.Id"/><input type="hidden" name="retorno" value="/Demandas/Detalhes/@Model.Demanda.Id"/>
@if(Model.Demanda.Status is "Concluída" or "Cancelada"){<button name="acao" value="reabrir" class="btn btn-link">Reabrir demanda</button>}else{<button name="acao" value="cancelar" class="btn btn-link text-danger">Cancelar demanda</button>}</form></section></div><div class="col-lg-5"><section class="painel"><h2>Detalhes da entrega</h2><dl class="detalhes"><dt>Recebida em</dt><dd>@Model.Demanda.DataRecebimento.ToString("dd/MM/yyyy")</dd><dt>Prazo</dt><dd>@(Model.Demanda.Prazo?.ToString("dd/MM/yyyy") ?? "Não definido")</dd><dt>Finalizada em</dt><dd>@(Model.Demanda.DataFinalizacao.HasValue ? ControleServico.Local(Model.Demanda.DataFinalizacao.Value).ToString("dd/MM/yyyy HH:mm") : "—")</dd></dl><h3>Descrição</h3><p class="texto-preservado">@(Model.Demanda.Descricao ?? "Nenhuma descrição informada.")</p><h3>Observações</h3><p class="texto-preservado">@(Model.Demanda.Observacoes ?? "—")</p></section></div></div>
<section class="painel tabela-painel mt-3">
    <div class="painel-titulo"><h2>Horas trabalhadas por dia</h2><a asp-action="Detalhes" asp-route-id="@Model.Demanda.Id" class="btn btn-outline-secondary">Atualizar horas</a></div>
    <p class="nota-horas">Todos os registros desta demanda, somados por dia. Pausas não entram no total. Horários de Brasília.@if (Model.Demanda.Status == "Em andamento") { <span> O trabalho em andamento está incluído até a abertura desta página.</span> }</p>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th scope="col">Dia trabalhado</th><th scope="col" class="text-end">Horas trabalhadas</th></tr></thead>
            <tbody>
            @foreach (var dia in Model.Dias)
            {
                <tr><td>@dia.Data.ToString("dd/MM/yyyy") <small class="text-muted ms-2">@dia.Data.ToString("dddd")</small></td><td class="text-end horas-dia">@Formato.Horas(dia.Segundos)</td></tr>
            }
            @if (Model.Dias.Count == 0)
            {
                <tr><td colspan="2" class="vazio"><strong>Nenhuma hora registrada</strong><span>Inicie o cronômetro ou registre um apontamento manual para esta demanda.</span></td></tr>
            }
            </tbody>
            <tfoot><tr><th scope="row">Total de horas da demanda</th><td class="text-end horas-dia">@Formato.Horas(Model.SegundosTotais)</td></tr></tfoot>
        </table>
    </div>
</section>
<section class="painel mt-4"><h2>Histórico da demanda</h2>@foreach(ControleHoras.Models.RegistroHistorico registro in ViewBag.Historico){<div class="evento"><span>@ControleServico.Local(registro.Data).ToString("dd/MM/yyyy HH:mm:ss")</span><strong>@registro.Acao</strong><small>@registro.Detalhes</small></div>}</section>
